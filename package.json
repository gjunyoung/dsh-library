{
  "name": "@local/dsh-library",
  "version": "1.0.1",
  "license": "MIT",
  "private": true,
  "description": "Local file archive: upload, browse, preview and reuse files inside DeepSeek Harness.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "file-manager",
    "library"
  ],
  "homepage": "https://github.com/gjunyoung/dsh-library#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjunyoung/dsh-library.git"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "locale/*.json",
    "docs/*",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
